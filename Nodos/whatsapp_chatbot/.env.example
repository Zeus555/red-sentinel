# Copiar a ~/Herramientas/WhatsApp_Checker/.env en sentinel005 (chmod 600).
# Se carga con: node --env-file=.env server.js
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_NUMBER=1xxxxxxxxxx
# Opcionales (tienen default):
# PORT=8002
# RQLITE_API=http://localhost:4001
# Credenciales de rqlite (usuario lector). Con las dos definidas el chatbot manda
# Authorization: Basic en todas sus peticiones a rqlite; sin ellas pregunta sin
# credenciales, como hasta ahora (un rqlited sin -auth las ignora). La clave va
# solo aqui, en el .env 600 del nodo: nunca en el repo.
# RQLITE_USER=
# RQLITE_PASSWORD=
